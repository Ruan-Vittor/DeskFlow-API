# Banco de dados PostgreSQL
# Para o cluster local dedicado criado por scripts/setup-local-db.ps1, use a porta 5433.
DB_URL=jdbc:postgresql://localhost:5432/deskflow
DB_USERNAME=deskflow
DB_PASSWORD=change-me

# Segredo JWT: use no minimo 32 caracteres aleatorios
JWT_SECRET=change-me-to-a-long-random-secret-with-32-plus-characters
JWT_EXPIRATION_MINUTES=60

# Servidor
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Administrador inicial (opcional). Deixe e-mail/senha vazios para desativar.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@deskflow.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-password
